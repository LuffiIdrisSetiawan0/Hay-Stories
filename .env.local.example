# Supabase (Wajib diisi)
# Dapatkan URL dan Anon Key dari Project Settings > API di dashboard Supabase Anda
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service Role Key — Project Settings > API > service_role
# RAHASIA. Hanya dipakai di route handler sisi server untuk jalur tamu anonim
# (join, terbitkan signed upload URL, catat foto). JANGAN pernah diekspos ke browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Kunci penandatangan token tamu (JWT HS256 via `jose`)
# Buat dengan: openssl rand -base64 32
GUEST_TOKEN_SECRET=your_random_32_byte_secret

# Midtrans Snap Redirect (wajib untuk paket berbayar)
# Dapatkan Server Key dari Dashboard Midtrans pada environment yang sesuai.
# Client Key tidak dipakai alur hosted redirect saat ini; boleh dikosongkan.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=your_midtrans_server_key
# Produksi HANYA aktif bila nilainya persis `true`. Biarkan false untuk sandbox.
MIDTRANS_IS_PRODUCTION=false

# URL Aplikasi
# Ganti dengan URL domain Anda saat production (misal: https://haystories.id)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HAY Stories

# Kontak dan identitas operator publik
# Boleh kosong untuk mode free-only. Isi support email yang dimonitor sebelum
# menguji checkout; identitas operator juga wajib sebelum pembayaran production.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS=
